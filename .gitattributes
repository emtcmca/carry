# Line endings: normalize text to LF in the repository and the working tree.
# Without this, core.autocrlf=false means git converts nothing, and a Windows tool
# that writes CRLF turns a small edit into a whole-file diff.
* text=auto eol=lf

# Windows batch files break with LF endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries: never let the text heuristic guess.
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.msg binary
*.sqlite binary
*.db binary
